---
// Estructura común de todas las páginas.
import "../estilos/tokens.css";
import "../estilos/base.css";
import Encabezado from "../components/Encabezado.astro";
import PiePagina from "../components/PiePagina.astro";

interface Props {
  titulo: string;
  descripcion: string;
}
const { titulo, descripcion } = Astro.props;
const nombreSitio = "Observatorio Legislativo";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo === nombreSitio ? titulo : `${titulo} · ${nombreSitio}`}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Encabezado nombreSitio={nombreSitio} />
    <main id="contenido" class="contenedor">
      <slot />
    </main>
    <PiePagina />
  </body>
</html>
