---
// Cuadro de una cámara con los legisladores de más votos distintos a la mayoría de su partido, en el
// orden de lib/votosDistintos.js: nombre con enlace a su ficha, partido (texto oficial) y la cifra con
// numerador y denominador. Usa los estilos de la tabla comparativa (estilos/tabla-comparativa.css), que
// en el celular muestran cada legislador como una tarjeta. Filas en una sola línea (ver TablaLegisladores).
import "../estilos/tabla-comparativa.css";
import { CIFRAS_MAYORIA } from "../lib/legisladores.js";

interface Props {
  titulo: string;
  filas: any[];
}
const { titulo, filas } = Astro.props;
const columna = CIFRAS_MAYORIA.find((c) => c.grupo === "partido")!.titulo;
---

<div class="tabla-comparativa-desplazable">
  <table class="tabla-comparativa">
    <caption class="solo-lectores">{titulo}</caption>
    <thead>
      <tr>
        <th scope="col">Nombre</th>
        <th scope="col">Partido</th>
        <th scope="col">{columna}</th>
      </tr>
    </thead>
    <tbody>
      {filas.map((f) => <tr data-votos-distintos data-slug={f.slug}><th scope="row"><a href={f.url}>{f.nombre}</a>{!f.vigente && <span class="chico texto-suave"> (ya no ejerce)</span>}</th><td>{f.mayoriaPartido.grupo}</td><td data-etiqueta={columna}>{f.mayoriaPartido.texto}</td></tr>)}
    </tbody>
  </table>
</div>
