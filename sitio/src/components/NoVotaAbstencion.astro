---
// NO VOTA y ABSTENCIÓN/BLANCO de un legislador en votaciones nominales, dos cifras separadas con el
// mismo denominador que las ausencias. Recibe el bloque de lib/legisladores.js (ficha).
import * as rutas from "../lib/rutas.js";

interface Props {
  noVota: any;
  abstencion: any;
  periodo: string;
}
const { noVota, abstencion, periodo } = Astro.props;
---

<dl class="no-vota-abstencion">
  <div><dt>NO VOTA</dt><dd><strong>{noVota.texto}</strong></dd></div>
  <div><dt>ABSTENCIÓN/BLANCO</dt><dd><strong>{abstencion.texto}</strong></dd></div>
</dl>
<p class="chico texto-suave lectura">
  Votaciones nominales del período {periodo} en que figura con cada categoría, sobre las mismas
  votaciones que las ausencias. NO VOTA indica que figura en la votación sin emitir voto y solo aparece en
  el Senado. ABSTENCIÓN/BLANCO es un voto oficial. Son cifras distintas y no se suman.{" "}
  <a href={rutas.metodologia(rutas.anclasMetodologia.noVotaAbstencion)}>Cómo se calcula</a>
  {" · "}
  <a href={rutas.votacionesNominales()}>Comparar con los demás legisladores</a>
</p>

<style>
  .no-vota-abstencion {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-3) var(--espacio-5);
    margin: 0 0 var(--espacio-1);
  }
  dt {
    font-size: var(--tamano-chico);
    color: var(--color-texto-suave);
  }
  dd {
    margin: 0;
    font-size: var(--tamano-titulo-3);
  }
</style>
