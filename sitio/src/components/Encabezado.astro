---
import { entradaActual, menuPrincipal } from "../lib/navegacion.js";
import * as rutas from "../lib/rutas.js";

interface Props {
  nombreSitio: string;
}
const { nombreSitio } = Astro.props;
const enlaces = menuPrincipal();
const actual = entradaActual(enlaces, Astro.url.pathname);
---

<header class="encabezado">
  <div class="contenedor fila">
    <a class="marca" href={rutas.inicio()}>{nombreSitio}</a>
    <nav aria-label="Principal">
      <ul>
        {
          enlaces.map((e) => (
            <li>
              <a href={e.url} aria-current={e === actual ? "page" : undefined}>
                {e.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .encabezado {
    border-bottom: var(--borde-ancho) solid var(--color-borde);
    background: var(--color-superficie);
  }
  .fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--espacio-2) var(--espacio-4);
    padding-top: var(--espacio-3);
    padding-bottom: var(--espacio-3);
  }
  .marca {
    font-weight: var(--peso-fuerte);
    color: var(--color-texto);
    text-decoration: none;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a,
  nav a:visited {
    color: var(--color-enlace);
  }
  nav a[aria-current="page"] {
    font-weight: var(--peso-fuerte);
    text-decoration-thickness: var(--foco-ancho);
  }
</style>
