---
// Iniciativa y autores de un registro de ley, tal como los publica el Congreso.
// El nombre de cada autor del período enlaza a su ficha; el de otras legislaturas, a SILpy.
interface Props {
  detalle: any;
  nivel: number;
}
const { detalle: d, nivel } = Astro.props;
const Titulo = `h${nivel}`;
const sinDato = "Sin dato";
---

<Titulo>Iniciativa y autores</Titulo>
<dl class="iniciativa">
  <div>
    <dt>Iniciativa</dt>
    <dd class={d.iniciativa ? undefined : "texto-suave"}>{d.iniciativa ?? sinDato}</dd>
  </div>
  {
    d.ministerios.length > 0 && (
      <div>
        <dt>{d.ministerios.length > 1 ? "Ministerios autores" : "Ministerio autor"}</dt>
        <dd>{d.ministerios.join(" · ")}</dd>
      </div>
    )
  }
</dl>
{
  d.autores.length === 0 ? (
    // Sin legisladores autores: si hay ministerio, ya figura arriba como autor del proyecto.
    d.ministerios.length === 0 && <p class="texto-suave">Autores: {sinDato}</p>
  ) : (
    <ul class="autores">
      {d.autores.map((a: any) => (
        <li>
          {a.ficha || a.url ? <a href={a.ficha ?? a.url}>{a.nombre ?? sinDato}</a> : <span>{a.nombre ?? sinDato}</span>}
          <span class="chico texto-suave">
            {" "}— Partido: {a.partido ?? sinDato}{a.partidoConocido && ` (${a.partidoConocido})`} · Bancada: {a.bancada ?? sinDato} · {a.camara ?? sinDato}
            {!a.delPeriodo && <strong> · Legislatura {a.legislatura ?? sinDato}</strong>}
          </span>
        </li>
      ))}
    </ul>
  )
}
{
  d.autores.some((a: any) => !a.delPeriodo) && (
    <p class="chico texto-suave lectura">
      Algunos autores eran legisladores de otra legislatura: se indica la legislatura, y su partido,
      bancada y cámara son los que la API registra para ella.
    </p>
  )
}

<style>
  .iniciativa {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-3) var(--espacio-5);
  }
  dt {
    font-size: var(--tamano-chico);
    color: var(--color-texto-suave);
  }
  dd {
    margin: 0;
  }
  .autores {
    padding-left: var(--espacio-4);
  }
  .autores li + li {
    margin-top: var(--espacio-1);
  }
</style>
