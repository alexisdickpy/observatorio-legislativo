---
// Temas de una ley o proyecto según la clasificación propia (lib/temas.js, #36), señalados como dato del
// Observatorio y no oficial. Cada tema enlaza al catálogo filtrado por ese tema.
import * as rutas from "../lib/rutas.js";
import { TEXTO_PENDIENTE } from "../lib/temas.js";

interface Props {
  clasificacion: { temas: { id: string; nombre: string; url: string }[]; pendiente: boolean };
}
const { clasificacion } = Astro.props;
---

<p class="temas chico">
  <span class="texto-suave">Tema según el Observatorio</span>
  {clasificacion.pendiente && <span class="tema">{TEXTO_PENDIENTE}</span>}
  {clasificacion.temas.map((t) => <a class="tema" href={t.url}>{t.nombre}</a>)}
  <a class="texto-suave" href={rutas.metodologia(rutas.anclasMetodologia.temas)}>Cómo se clasifica</a>
</p>

<style>
  .temas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--espacio-1) var(--espacio-2);
  }
  .tema {
    padding: 0 var(--espacio-2);
    border: var(--borde-ancho) solid var(--color-borde);
    border-radius: var(--radio);
  }
</style>
