---
// Ficha de un legislador: datos oficiales del cargo, resumen e historial de sus votos en las
// votaciones nominales de leyes y leyes de su autoría (preparado por lib/legisladores.js).
import Base from "../../layouts/Base.astro";
import HistorialVotos from "../../components/HistorialVotos.astro";
import ResumenVotos from "../../components/ResumenVotos.astro";
import { ficha, legisladores } from "../../lib/legisladores.js";
import * as rutas from "../../lib/rutas.js";
import { datosDeLegislador, descripcionDeLegislador, imagenDe } from "../../lib/seo.js";

export function getStaticPaths() {
  return legisladores().map((persona) => ({ params: { slug: persona.slug }, props: { persona } }));
}

const { persona } = Astro.props;
const f = ficha(persona);
const varios = f.bloques.length > 1;
const Titulo = varios ? "h3" : "h2";
const sinDato = "Sin dato";
const actual = f.bloques[0];
const descripcion = descripcionDeLegislador(f, sinDato);
---

<Base
  titulo={f.nombre ?? sinDato}
  descripcion={descripcion}
  imagen={imagenDe(actual.foto, f.nombre ?? sinDato)}
  datos={datosDeLegislador(f, persona.url)}
  tipo="profile"
>
  <p class="chico"><a href={rutas.legisladores()}>← Todos los legisladores</a></p>
  <article data-pagefind-body>
    <h1 data-pagefind-meta="title">{f.nombre ?? sinDato}</h1>
    {
      f.bloques.map((b: any) => (
        <section class="bloque">
          {varios && <h2>Período legislativo {b.periodo}</h2>}
          <div class="cabecera">
            {b.foto && (
              <figure>
                <img src={b.foto} alt={`Foto oficial de ${b.nombre ?? sinDato}`} width="160" height="160" />
                <figcaption class="chico texto-suave">Foto del Congreso Nacional (SILpy)</figcaption>
              </figure>
            )}
            <dl>
              <div><dt>Período legislativo</dt><dd>{b.periodo}</dd></div>
              <div><dt>Cámara</dt><dd>{b.camara ?? sinDato}</dd></div>
              <div><dt>Tipo</dt><dd>{b.tipo ?? sinDato}</dd></div>
              <div><dt>Departamento</dt><dd>{b.departamento ?? sinDato}</dd></div>
              <div><dt>Partido</dt><dd>{b.partido ?? sinDato}{b.partidoConocido && ` (${b.partidoConocido})`}</dd></div>
              <div><dt>Bancada</dt><dd>{b.bancada ?? sinDato}</dd></div>
              <div><dt>Cargo en la bancada</dt><dd class={b.cargoBancada ? undefined : "texto-suave"}>{b.cargoBancada ?? sinDato}</dd></div>
              <div><dt>Correo</dt><dd class={b.correo ? "contacto" : "texto-suave"}>{b.correo ? <a href={`mailto:${b.correo}`}>{b.correo}</a> : sinDato}</dd></div>
              <div><dt>Teléfono</dt><dd class={b.telefono ? undefined : "texto-suave"}>{b.telefono ?? sinDato}</dd></div>
              {b.periodoVigente && <div><dt>Situación</dt><dd>{b.vigente ? "En ejercicio" : "Ya no ejerce"}</dd></div>}
            </dl>
          </div>
          {
            b.periodoVigente && !b.vigente && (
              <p class="aviso lectura">
                Ya no figura entre los legisladores en ejercicio que publica la API. Esta ficha conserva
                sus votos y sus leyes del período.
              </p>
            )
          }
          <p class="aviso chico lectura">
            Partido y bancada son los que la API registra en el período {b.periodo};
            no necesariamente eran los vigentes en la fecha de cada votación.
            {b.camara === "CAMARA DE SENADORES" && " Los senadores se eligen en una circunscripción nacional, por eso la API registra su departamento como NACIONAL."}
            {b.partidoConocido && " El nombre entre paréntesis es el nombre por el que se conoce a su partido, un agregado de este sitio. El que va antes es el oficial."}
            {" "}<a href={rutas.metodologia(rutas.anclasMetodologia.afiliacion)}>Más información</a>
          </p>
          {b.urlSilpy && <p class="chico"><a href={b.urlSilpy}>Ficha oficial en SILpy</a></p>}

          <div data-pagefind-ignore="all">
            <Titulo>Sus votos en votaciones nominales de leyes</Titulo>
            {
              b.votos.total === 0 ? (
                <p class="lectura">
                  No figura en ninguna votación nominal de leyes sancionadas del período {b.periodo}.
                </p>
              ) : (
                <ResumenVotos votos={b.votos} periodo={b.periodo} />
              )
            }

            <Titulo>Leyes sancionadas de su autoría ({b.autoria.length})</Titulo>
            {
              b.autoria.length === 0 ? (
                <p class="lectura">
                  No figura entre los autores del proyecto de ninguna ley sancionada en el período {b.periodo}.
                </p>
              ) : (
                <Fragment>
                  <p class="chico texto-suave lectura">
                    Leyes del período en cuyo proyecto figura entre los autores, de la más reciente a la más antigua.
                  </p>
                  <ul class="autoria">
                    {b.autoria.map((l: any) => <li><a href={l.url}>Ley {l.numero}</a> <span class="texto-suave chico">· {l.fechaSancion ? `Sancionada el ${l.fechaSancion}` : "Fecha de sanción sin dato"}</span><span class="titulo chico">{l.titulo ?? sinDato}</span></li>)}
                  </ul>
                </Fragment>
              )
            }

            {
              b.votos.total > 0 && (
                <Fragment>
                  <Titulo>Historial de votos ({b.votos.total})</Titulo>
                  <p class="chico texto-suave lectura">
                    De la más reciente a la más antigua. Cada ley lleva a la votación dentro de su ficha,
                    con los totales y el voto de cada legislador.
                  </p>
                  <HistorialVotos historial={b.votos.historial} />
                </Fragment>
              )
            }
          </div>
        </section>
      ))
    }
  </article>
</Base>

<style>
  .cabecera {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-4) var(--espacio-5);
    align-items: flex-start;
    margin-bottom: var(--espacio-4);
  }
  figure {
    margin: 0;
  }
  img {
    display: block;
    width: var(--tamano-foto-legislador);
    height: var(--tamano-foto-legislador);
    object-fit: cover;
    border-radius: var(--radio);
    background: var(--color-superficie);
  }
  figcaption {
    margin-top: var(--espacio-1);
  }
  dl {
    flex: 1 1 20rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--ancho-campo-filtro), 1fr));
    gap: var(--espacio-3) var(--espacio-4);
    margin: 0;
  }
  dt {
    font-size: var(--tamano-chico);
    color: var(--color-texto-suave);
  }
  dd {
    margin: 0;
  }
  .contacto {
    overflow-wrap: anywhere;
  }
  .aviso {
    padding: var(--espacio-3) var(--espacio-4);
    background: var(--color-superficie);
    border-left: var(--foco-ancho) solid var(--color-acento);
  }
  .autoria {
    padding-left: var(--espacio-4);
  }
  .autoria li + li {
    margin-top: var(--espacio-2);
  }
  .autoria .titulo {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--lineas-titulo-catalogo);
    line-clamp: var(--lineas-titulo-catalogo);
    overflow: hidden;
  }
</style>
