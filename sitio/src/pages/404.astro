---
// Página para direcciones que no existen. Cloudflare Pages la sirve con el código 404; sin ella,
// respondería cualquier dirección con la portada. No se indexa.
import Base from "../layouts/Base.astro";
import * as rutas from "../lib/rutas.js";
---

<Base titulo="Página no encontrada" descripcion="La dirección no corresponde a ninguna página de este sitio." indexar={false}>
  <div class="lectura">
    <h1>Página no encontrada</h1>
    <p>Esta dirección no corresponde a ninguna página del sitio. Puede que esté mal escrita o que la página haya cambiado de lugar.</p>
    <ul>
      <li><a href={rutas.inicio()}>Ir al inicio</a></li>
      <li><a href={rutas.leyes()}>Ver todas las leyes</a></li>
      <li><a href={rutas.legisladores()}>Ver todos los legisladores</a></li>
      <li><a href={rutas.buscar()}>Buscar en el sitio</a></li>
    </ul>
  </div>
</Base>
